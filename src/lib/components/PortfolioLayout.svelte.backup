            href={link.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="project-link project-link--{link.type}"
          >
            {link.label || link.type}
          </a>
        {/each}
      </div>
    {/if}
  </header>
  
  <div class="post-content">
    <slot />
  </div>
  
  {#if showToolsSection && tools.length > 0}
    <ToolsUsed {tools} />
  {/if}
</article>

