<script lang="ts">
  import ToolsUsed from '$lib/components/ToolsUsed.svelte';
  import type { ProjectTool } from '$lib/types/tools.js';
  
  export let title: string;
  export let description: string;
  export let client: string | undefined = undefined;
  export let duration: string | undefined = undefined;
  export let role: string | undefined = undefined;
  export let status: 'completed' | 'in-progress' | 'archived' | undefined = undefined;
  export let date: string;
  export let tools: ProjectTool[] = [];
  export let showToolsSection: boolean = true;
  export let links: Array<{type: string, url: string, label?: string}> = [];
